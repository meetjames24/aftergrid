#!/bin/bash
# One-screen health check for Aftergrid.
ok(){ printf "  \e[32m✓\e[0m %s\n" "$*"; }; no(){ printf "  \e[33m•\e[0m %s\n" "$*"; }
echo "Aftergrid status"
if [ -n "$(ls -A /run/live/persistence 2>/dev/null)" ] || ! [ -d /run/live ]; then ok "Changes are saved (persistence on, or installed system)"
else no "Persistence OFF: changes vanish at shutdown (Aftergrid Control -> Set up this stick, then boot 'Encrypted persistence')"; fi
mountpoint -q /vault && ok "VAULT mounted at /vault ($(df -h --output=avail /vault | tail -1 | xargs) free)" || no "No VAULT partition (extra downloads go nowhere until you run Set up this stick)"
python3 - <<'PY'
import json
try: i = json.load(open('/run/aftergrid/index.json'))
except Exception: i = {}
z, m, p = len(i.get('zims', [])), len(i.get('maps', [])), len(i.get('pdfs', []))
print(f"  \033[32m✓\033[0m Library: {z} books, {p} manuals, {m} map regions")
print(("  \033[32m✓\033[0m Offline AI running" if i.get('ai') else "  \033[33m•\033[0m Offline AI off" + ("" if i.get('models') else " (no model: Download -> ai)")))
if i.get('hotspot'): print(f"  \033[32m✓\033[0m Hotspot ON: Wi-Fi '{i['hotspot']}', phones open http://10.42.0.1")
PY
systemctl is-active -q aftergrid-kiwix && ok "Library server running (Field Mode: http://localhost)" || no "Library server not running: sudo systemctl restart aftergrid-kiwix"
[ -w /dev/kvm ] && ok "Virtualization available (Claude Cowork works)" || no "No KVM: enable virtualization (VT-x/AMD-V) in BIOS for Claude Cowork"
ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && ok "Online" || no "Offline: Field Mode, maps, mesh and radio tools all work without internet"
