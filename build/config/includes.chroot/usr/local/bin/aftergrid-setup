#!/usr/bin/env python3
"""Aftergrid first-time setup: a short, skippable walk-through on first login.

  1. Language
  2. Encrypted saves on the stick (live stick only; takes effect after a restart)
  3. Your own account (once saves are active; an installed system already has one)
  4. Wi-Fi (optional)
  5. Downloads (optional: more library, maps, a bigger offline AI)
  6. Finish: open Field Mode, switch to your account

Runs automatically until finished (flag: /var/lib/aftergrid/setup-done, kept by the encrypted saves).
Run again any time: Aftergrid Control -> Run first-time setup again, or `aftergrid-setup --again`.
"""
import json, os, re, shutil, subprocess, sys, time

DONE = "/var/lib/aftergrid/setup-done"                              # system-wide (kept by the encrypted saves)
USER_DONE = os.path.expanduser("~/.config/aftergrid-setup-done")   # per user (installed systems, where sudo needs a password)
CATALOG = "/usr/share/aftergrid/catalog.json"
LIVE = os.path.isdir("/run/live/medium")
LIVE_USER = "aftergrid"
GROUPS = "audio,cdrom,dip,video,plugdev,netdev,bluetooth,kvm,sudo,dialout,users"
