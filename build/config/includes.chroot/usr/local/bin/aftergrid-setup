LANG = "en"
def t(k, *a): return T[k].get(LANG, T[k]["en"]).format(*a)

# ---------------------------------------------------------------- helpers
def kd(*args, check=False):
    """Run kdialog. Returns (ok, stdout)."""
    r = subprocess.run(["kdialog", "--title", t("title"), *args], capture_output=True, text=True)
    return r.returncode == 0, r.stdout.strip()
def msg(text): kd("--msgbox", text)
def yesno(text, yes=None, no=None):
    a = ["--yesno", text] + (["--yes-label", yes] if yes else []) + (["--no-label", no] if no else [])
    return kd(*a)[0]
def sudo(cmd, stdin=None):
    r = subprocess.run(["sudo", "-n", *cmd], input=stdin, capture_output=True, text=True)
    return r.returncode == 0, (r.stderr or r.stdout).strip()[-600:]
def sh(cmd): return subprocess.run(cmd, capture_output=True, text=True).stdout
def persistence_active():
    return any("/run/live/persistence" in l for l in open("/proc/mounts"))
def boot_disk():
    for l in open("/proc/mounts"):
        if " /run/live/medium " in l:
            dev = l.split()[0]
            return "/dev/" + sh(["lsblk", "-no", "PKNAME", dev]).strip().splitlines()[0] if dev.startswith("/dev/") else None
def saves_exist(disk):
    out = sh(["lsblk", "-rno", "FSTYPE,LABEL", disk]) if disk else ""
    return "crypto_LUKS" in out or re.search(r"\bpersistence\b", out) is not None
def vault():
    out = sh(["lsblk", "-rno", "LABEL,MOUNTPOINT"])
    return any(l.split(" ")[0] == "VAULT" for l in out.splitlines())
def online(): return sh(["nmcli", "-t", "-f", "STATE", "general"]).strip().startswith("connected")
def human_users():
    return [l.split(":")[0] for l in open("/etc/passwd") if 1000 <= int(l.split(":")[2]) < 60000 and l.split(":")[0] != LIVE_USER]

# ---------------------------------------------------------------- steps
def step_language():
    global LANG
    args = []
    for code, name, *_ in LANGS: args += [code, name]
    cur = (os.environ.get("LANG", "en")[:2])
    ok, pick = kd("--default", dict((c, n) for c, n, *_ in LANGS).get(cur, "English"), "--menu", "Aftergrid: " + T["lang_q"]["en"] + " / " + T["lang_q"]["el"], *args)
    if not ok: return
    LANG = pick
    code, name, loc, kb = next(x for x in LANGS if x[0] == pick)
    # Desktop language and keyboard follow at the next sign-in; Field Mode follows the browser language.
    subprocess.run(["kwriteconfig6", "--file", "plasma-localerc", "--group", "Formats", "--key", "LANG", loc])
    subprocess.run(["kwriteconfig6", "--file", "plasma-localerc", "--group", "Translations", "--key", "LANGUAGE", loc.split(".")[0]])
    subprocess.run(["kwriteconfig6", "--file", "kxkbrc", "--group", "Layout", "--key", "LayoutList", kb])
    subprocess.run(["kwriteconfig6", "--file", "kxkbrc", "--group", "Layout", "--key", "Use", "true"])
    sudo(["localectl", "set-locale", f"LANG={loc}"])

def step_saves():
    """Live stick without saves: create them (needs a restart). Returns 'restart', 'skip' or 'ok'."""
    if not LIVE or persistence_active(): return "ok"
    disk = boot_disk()
    if saves_exist(disk):
        if yesno(t("saves_exist")): subprocess.run(["systemctl", "reboot"]); return "restart"
        return "skip"
    if not yesno(t("saves_q"), t("yes_save"), t("not_now")): return "skip"
    while True:
        ok, p1 = kd("--password", t("pass1"))
        if not ok: return "skip"
        if len(p1) < 8: msg(t("pass_short")); continue
        ok, p2 = kd("--password", t("pass2"))
        if not ok: return "skip"
        if p1 != p2: msg(t("pass_mismatch")); continue
        break
    bar = subprocess.Popen(["kdialog", "--title", t("title"), "--passivepopup", t("saves_working"), "90"])
    ok, out = sudo(["/usr/local/sbin/aftergrid-setup-stick", "--yes", "--pass-stdin"], stdin=p1 + "\n")
    bar.terminate()
    if not ok: msg(t("saves_failed", out)); return "skip"
    if yesno(t("saves_done")): subprocess.run(["systemctl", "reboot"])
    return "restart"

def step_account():
    """Returns the new username, or None."""
    if not LIVE or not persistence_active() or human_users(): return None
    msg(t("acct_intro"))
    ok, full = kd("--inputbox", t("full_name"), "")
    if not ok: return None
    sugg = re.sub(r"[^a-z0-9]", "", full.lower().split(" ")[0]) or "me"
    while True:
        ok, user = kd("--inputbox", t("user_name"), sugg)
        if not ok: return None
        exists = subprocess.run(["id", user], capture_output=True).returncode == 0
        if re.fullmatch(r"[a-z][a-z0-9_-]{1,29}", user) and not exists and user not in ("root", "aftergrid", "admin"): break
        msg(t("user_bad"))
    while True:
        ok, p1 = kd("--password", t("user_pass"))
        if not ok: return None
        if len(p1) < 8: msg(t("pass_short")); continue
        ok, p2 = kd("--password", t("pass2"))
        if not ok: return None
        if p1 != p2: msg(t("pass_mismatch")); continue
        break
    ok, out = sudo(["useradd", "-m", "-c", full.replace(":", " "), "-s", "/bin/bash", "-G", GROUPS, user])
    if ok: ok, out = sudo(["chpasswd"], stdin=f"{user}:{p1}\n")
    if not ok: msg(t("acct_failed", out)); return None
    auto = yesno(t("autologin_q"))
    conf = f"[Autologin]\nUser={user}\nSession=plasma\n" if auto else "[Autologin]\nUser=\n"
    sudo(["sh", "-c", f"mkdir -p /etc/sddm.conf.d && printf '%s' '{conf}' > /etc/sddm.conf.d/zz-aftergrid-user.conf"])
    # The new account starts in the language chosen here.
    loc = next(x for x in LANGS if x[0] == LANG)
    sudo(["sh", "-c", f"mkdir -p /home/{user}/.config && printf '[Formats]\\nLANG={loc[2]}\\n[Translations]\\nLANGUAGE={loc[2].split('.')[0]}\\n' > /home/{user}/.config/plasma-localerc && printf '[Layout]\\nLayoutList={loc[3]}\\nUse=true\\n' > /home/{user}/.config/kxkbrc && chown -R {user}: /home/{user}/.config"])
    msg(t("acct_done", user))
    return user

def step_wifi():
    if online(): return True
    if not yesno(t("wifi_q")): return False
    while True:
        rows = sh(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes"]).splitlines()
        nets = {}
        for r in rows:
            parts = re.split(r"(?<!\\):", r)
            if len(parts) < 3 or not parts[0]: continue
            ssid = parts[0].replace("\\:", ":")
            sig = int(parts[1] or 0)
            if ssid not in nets or nets[ssid][0] < sig: nets[ssid] = (sig, parts[2])
        if not nets: msg(t("wifi_none")); return False
        items = []
        for ssid, (sig, sec) in sorted(nets.items(), key=lambda x: -x[1][0])[:20]:
            items += [ssid, f"{ssid}   {'▂▄▆█'[:max(1, min(4, sig // 25))]}{'  🔒' if sec and sec != '--' else ''}"]
        ok, ssid = kd("--menu", t("wifi_pick"), *items)
        if not ok: return False
        if ssid not in nets: continue
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if nets[ssid][1] and nets[ssid][1] != "--":
            ok, pw = kd("--password", t("wifi_pass", ssid))
            if not ok: continue
            cmd += ["password", pw]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0 and online(): msg(t("wifi_ok", ssid)); return True
        if not yesno(t("wifi_fail", ssid)): return False

def step_downloads():
    if not online(): msg(t("dl_offline")); return
    if LIVE and not vault(): msg(t("dl_novault")); return
    tiers = json.load(open(CATALOG))["tiers"]
    args = []
    for k, v in tiers.items(): args += [k, v["label"], "off"]
    ok, picked = kd("--geometry", "760x560", "--checklist", t("dl_q"), *args)
    picked = picked.replace('"', "").split()
    if ok and picked:
        subprocess.Popen(["konsole", "--hold", "-e", "aftergrid-vault-sync", *picked], start_new_session=True)

def finish(user):
    sudo(["sh", "-c", f"mkdir -p {os.path.dirname(DONE)} && date -Is > {DONE}"])
    os.makedirs(os.path.dirname(USER_DONE), exist_ok=True); open(USER_DONE, "w").write(time.strftime("%F %T\n"))
    if yesno(t("finish")): subprocess.Popen(["xdg-open", "http://localhost/"], start_new_session=True)
    if user and yesno(t("switch_q", user)):
        subprocess.run(["qdbus", "org.kde.Shutdown", "/Shutdown", "logout"])

def main():
    if (os.path.exists(DONE) or os.path.exists(USER_DONE)) and "--again" not in sys.argv: return
    if "--again" not in sys.argv: time.sleep(6)   # let the desktop settle
    step_language()
    ok, pick = kd("--menu", t("welcome"), "go", t("start"), "skip", t("skip_all"))
    if not ok or pick == "skip": return            # asked again next time, unless saves make it stick
    if step_saves() == "restart": return           # setup continues after the restart
    user = None
    for step in (step_account, step_wifi, step_downloads):
        try:
            r = step()
            if step is step_account: user = r
        except Exception as e:                      # a broken step must not end the whole setup
            print("aftergrid-setup:", step.__name__, e, file=sys.stderr)
    finish(user)

if __name__ == "__main__":
    if shutil.which("kdialog") is None: sys.exit("kdialog is not installed")
    main()
