# Aftergrid boot splash: logo, amber progress line, passphrase prompt for encrypted persistence.
Window.SetBackgroundTopColor(0.078, 0.090, 0.102);
Window.SetBackgroundBottomColor(0.110, 0.129, 0.149);
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 60, 1);

barbg.image = Image("bar-bg.png");
barbg.sprite = Sprite(barbg.image);
barbg.sprite.SetPosition(cx - barbg.image.GetWidth() / 2, cy + logo.image.GetHeight() / 2 - 20, 1);
bar.full = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(cx - barbg.image.GetWidth() / 2, cy + logo.image.GetHeight() / 2 - 20, 2);

fun progress_cb(duration, progress) {
  w = Math.Int(bar.full.GetWidth() * progress);
  if (w < 1) w = 1;
  bar.sprite.SetImage(bar.full.Scale(w, bar.full.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_cb);

# --- passphrase (encrypted persistence) ---
entry.image = Image("entry.png");
entry.sprite = Sprite(); prompt.sprite = Sprite(); dots.sprite = Sprite();
fun password_cb(prompt_text, bullets) {
  ey = cy + logo.image.GetHeight() / 2 + 20;
  prompt.image = Image.Text("Passphrase to unlock your saved Aftergrid", 0.91, 0.93, 0.94);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, ey, 3);
  entry.sprite.SetImage(entry.image);
  entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, ey + 28, 3);
  s = ""; for (i = 0; i < bullets && i < 28; i++) s += "*";
  dots.image = Image.Text(s, 0.95, 0.64, 0.23);
  dots.sprite.SetImage(dots.image);
  dots.sprite.SetPosition(cx - dots.image.GetWidth() / 2, ey + 40, 4);
  entry.sprite.SetOpacity(1); prompt.sprite.SetOpacity(1); dots.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_cb);
fun normal_cb() { entry.sprite.SetOpacity(0); prompt.sprite.SetOpacity(0); dots.sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(normal_cb);

# --- messages (e.g. "wrong passphrase") ---
msg.sprite = Sprite();
fun message_cb(text) {
  msg.image = Image.Text(text, 0.60, 0.64, 0.68);
  msg.sprite.SetImage(msg.image);
  msg.sprite.SetPosition(cx - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 5);
}
Plymouth.SetMessageFunction(message_cb);
